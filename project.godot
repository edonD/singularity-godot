; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited via text.

config_version=5

[application]

config/name="Singularity Survivor"
config/description="Year 2029. Survive against NEXUS, a superintelligence that consumed civilization."
run/main_scene="res://scenes/ui/TitleScreen.tscn"
config/features=PackedStringArray("4.4")

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
CameraManager="*res://scripts/autoload/camera_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="viewport"
window/stretch/aspect="keep"

